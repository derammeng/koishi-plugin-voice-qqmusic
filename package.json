{
  "name": "koishi-plugin-voice-qqmusic",
  "version": "1.1.0",
  "description": "一个QQ音乐点歌插件，需使用自己的账号",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib",
    "readme.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "author": "derammeng",
  "license": "MIT",
  "homepage": "https://github.com/derammeng/koishi-plugin-voice-qqmusic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/derammeng/koishi-plugin-voice-qqmusic.git"
  },
  "bugs": {
    "url": "https://github.com/derammeng/koishi-plugin-voice-qqmusic/issues"
  },
  "keywords": [
    "koishi",
    "plugin",
    "music",
    "qqmusic",
    "qq音乐",
    "点歌"
  ],
  "peerDependencies": {
    "koishi": "^4.15.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "koishi": {
    "description": {
      "zh": "QQ音乐点歌插件，支持语音发送和群聊私聊差异化配置"
    },
    "service": {
      "required": ["http"]
    },
    "locales": {
      "zh": {
        "description": "QQ音乐点歌插件，支持语音发送和群聊私聊差异化配置",
        "usage": "使用文档：\n1. 配置 QQ 音乐 Cookie 和 QQ 号\n2. 使用指令：点歌 <关键词>\n3. 支持群聊和私聊差异化配置",
        "options": {
          "cookie": "QQ 音乐 Cookie（从浏览器开发者工具复制）",
          "uin": "QQ 号码",
          "groupVoiceEnabled": "群聊中是否发送语音消息",
          "privateVoiceEnabled": "私聊中是否发送语音消息"
        }
      }
    }
  }
}
